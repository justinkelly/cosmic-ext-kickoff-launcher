{
  "app-id": "com.github.cosmic-kickoff-launcher",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-kickoff-launcher",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-data/applications:ro",
    "--filesystem=xdg-config/com.github.cosmic-kickoff-launcher:create"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-kickoff-launcher/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-kickoff-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release",
        "install -Dm755 target/release/cosmic-kickoff-launcher /app/bin/cosmic-kickoff-launcher",
        "install -Dm644 target/xdgen/app.desktop /app/share/applications/com.github.cosmic-kickoff-launcher.desktop",
        "install -Dm644 target/xdgen/app.metainfo.xml /app/share/appdata/com.github.cosmic-kickoff-launcher.metainfo.xml",
        "install -Dm644 resources/icon.svg /app/share/icons/hicolor/scalable/apps/com.github.cosmic-kickoff-launcher.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        },
        "generated-sources.json"
      ]
    }
  ]
}
