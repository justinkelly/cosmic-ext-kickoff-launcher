[Desktop Entry]
Name=KDE Launcher for Cosmic
Comment=A KDE-style application menu
Type=Application
Icon=com.github.cosmic-kde-launcher
Exec=cosmic-kde-launcher
Terminal=false
StartupNotify=true
Categories=COSMIC;
Keywords=COSMIC;Menu;Launcher;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-HostWaylandDisplay=true
X-OverflowPriority=50
